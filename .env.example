# Chaîne de connexion PostgreSQL (pooling possible, ex. Neon/Supabase "pooled")
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# Connexion directe (sans pooler) utilisée par les migrations Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# Seed de démonstration uniquement : refusé en production sauf ALLOW_DEMO_SEED=true
SEED_ADMIN_PASSWORD="choisir-un-mot-de-passe-fort"

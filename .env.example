# --- Développement local avec Docker (docker compose up -d) ---------------
# Copier ce fichier en .env : les valeurs ci-dessous fonctionnent telles quelles.
DATABASE_URL="postgresql://rowing:rowing@localhost:5433/rowing?schema=public"
DIRECT_URL="postgresql://rowing:rowing@localhost:5433/rowing?schema=public"

# Mot de passe des comptes de démonstration créés par « npm run db:seed »
# (10 caractères minimum ; le seed est refusé en production)
SEED_ADMIN_PASSWORD="aviron-demo-2026"

# --- Production (Vercel + Neon/Supabase…) ---------------------------------
# DATABASE_URL = URL « poolée » de l'hébergeur, DIRECT_URL = URL directe (migrations)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
